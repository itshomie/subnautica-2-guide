---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/guides';

const title = 'Terms of Use';
const description = 'Terms of Use for Subnautica 2 Guide, an unofficial fan-made guide site.';
---

<BaseLayout title={title} description={description} canonical={`${site.url}/terms-of-use/`}>
  <section class="content-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Terms of Use', href: '/terms-of-use/' }]} />
    <p class="eyebrow">Last updated: May 18, 2026</p>
    <h1>Terms of Use</h1>
    <p>
      By using Subnautica 2 Guide, you agree to these Terms of Use. If you do
      not agree, do not use the site.
    </p>

    <h2>Informational Content</h2>
    <p>
      The site provides unofficial guide content for informational purposes.
      Subnautica 2 is in Early Access, so routes, recipes, features, and
      availability may change.
    </p>

    <h2>Intellectual Property</h2>
    <p>
      Site text, layout, and original explanatory illustrations are owned by or
      licensed to Subnautica 2 Guide unless otherwise stated. Subnautica and
      Unknown Worlds names and marks belong to their respective owners.
    </p>

    <h2>Acceptable Use</h2>
    <ul>
      <li>Do not attempt to disrupt, scrape at abusive scale, or attack the site.</li>
      <li>Do not copy substantial portions of the site for republication without permission.</li>
      <li>Do not use the site in a way that violates applicable law.</li>
    </ul>

    <h2>No Warranty</h2>
    <p>
      The site is provided as is. We do not guarantee that every guide detail is
      complete, current, or error-free.
    </p>

    <h2>Contact</h2>
    <p>
      Questions about these terms can be sent to
      <a class="text-link" href="mailto:support@subnautica-2-guide.com">support@subnautica-2-guide.com</a>.
    </p>
  </section>
</BaseLayout>
