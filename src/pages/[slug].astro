---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GuideCard from '../components/GuideCard.astro';
import { getRelatedGuides, guides, site, type Guide } from '../data/guides';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide }
  }));
}

const { guide } = Astro.props as { guide: Guide };
const relatedGuides = getRelatedGuides(guide);
const canonical = `${site.url}/${guide.slug}/`;
const guideVisuals: Record<string, { src: string; alt: string; caption: string }> = {
  'subnautica-2-beginners-guide': {
    src: '/images/beginner-loop.jpg',
    alt: 'Original five-step survival loop illustration for a beginner route',
    caption: 'Original planning illustration, for readability.'
  },
  'subnautica-2-walkthrough': {
    src: '/images/beginner-loop.jpg',
    alt: 'Original survival loop illustration for early walkthrough planning',
    caption: 'Original planning illustration, for readability.'
  },
  'subnautica-2-resources': {
    src: '/images/resource-checklist.jpg',
    alt: 'Original resource checklist illustration with abstract underwater materials',
    caption: 'Original resource checklist illustration, for readability.'
  },
  'subnautica-2-item-codes': {
    src: '/images/resource-checklist.jpg',
    alt: 'Original checklist illustration for Subnautica 2 item codes and command testing',
    caption: 'Original item code checklist illustration, for readability.'
  },
  'subnautica-2-silver': {
    src: '/images/resource-checklist.jpg',
    alt: 'Original resource checklist illustration for material tracking',
    caption: 'Original resource checklist illustration, for readability.'
  },
  'subnautica-2-gold': {
    src: '/images/resource-checklist.jpg',
    alt: 'Original resource checklist illustration for material tracking',
    caption: 'Original resource checklist illustration, for readability.'
  },
  'subnautica-2-lead': {
    src: '/images/resource-checklist.jpg',
    alt: 'Original resource checklist illustration for material tracking',
    caption: 'Original resource checklist illustration, for readability.'
  },
  'subnautica-2-sulphur': {
    src: '/images/resource-checklist.jpg',
    alt: 'Original resource checklist illustration for material tracking',
    caption: 'Original resource checklist illustration, for readability.'
  },
  'subnautica-2-salt': {
    src: '/images/resource-checklist.jpg',
    alt: 'Original resource checklist illustration for material tracking',
    caption: 'Original resource checklist illustration, for readability.'
  },
  'subnautica-2-fibrous-pulp': {
    src: '/images/resource-checklist.jpg',
    alt: 'Original resource checklist illustration for material tracking',
    caption: 'Original resource checklist illustration, for readability.'
  },
  'subnautica-2-map': {
    src: '/images/route-notebook.jpg',
    alt: 'Original route notebook illustration with compass, depth, hazard, equipment, and check symbols',
    caption: 'Original route notebook illustration, for readability.'
  },
  'subnautica-2-best-base-locations': {
    src: '/images/route-notebook.jpg',
    alt: 'Original route notebook illustration for comparing base location criteria',
    caption: 'Original route notebook illustration, for readability.'
  },
  'subnautica-2-base-building': {
    src: '/images/base-layout.jpg',
    alt: 'Original compact underwater base layout blueprint illustration',
    caption: 'Original base layout illustration, for readability.'
  },
  'subnautica-2-habitat-builder': {
    src: '/images/base-layout.jpg',
    alt: 'Original compact underwater base layout blueprint illustration',
    caption: 'Original base layout illustration, for readability.'
  },
  'subnautica-2-fabricator': {
    src: '/images/base-layout.jpg',
    alt: 'Original compact underwater base layout blueprint illustration',
    caption: 'Original base layout illustration, for readability.'
  },
  'subnautica-2-multiplayer': {
    src: '/images/multiplayer-roles.jpg',
    alt: 'Original co-op role planning illustration for four-player underwater exploration',
    caption: 'Original co-op planning illustration, for readability.'
  }
};
const guideVisual = guideVisuals[guide.slug];
const hasCommandRows = Boolean(guide.commandRows?.length);
const hasItemCodeRows = Boolean(guide.itemCodeRows?.length);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Subnautica 2 Guide',
      item: site.url
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: guide.title,
      item: canonical
    }
  ]
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  ...(guideVisual ? { image: `${site.url}${guideVisual.src}` } : {}),
  dateModified: site.isoUpdated,
  datePublished: site.isoUpdated,
  mainEntityOfPage: canonical,
  author: {
    '@type': 'Organization',
    name: site.name
  },
  publisher: {
    '@type': 'Organization',
    name: site.name
  }
};

const faqSchema = guide.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: guide.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer
        }
      }))
    }
  : undefined;
---

<BaseLayout
  title={guide.title}
  description={guide.description}
  canonical={canonical}
  image={guideVisual?.src}
  jsonLd={faqSchema ? [breadcrumbSchema, articleSchema, faqSchema] : [breadcrumbSchema, articleSchema]}
>
  <article class="guide-page">
    <div class="guide-page__header">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: guide.shortTitle, href: `/${guide.slug}/` }]} />
      <p class="eyebrow">{guide.category}</p>
      <h1>{guide.title}</h1>
      <p class="guide-page__dek">{guide.description}</p>
      <div class="guide-meta">
        <span>Last updated: {site.lastUpdated}</span>
        <span>{guide.status}</span>
      </div>
      <p class="version-note">{site.versionNote}</p>
    </div>

    <div class="guide-page__layout">
      <aside class="guide-toc" aria-label="Page summary">
        <strong>Best for</strong>
        <p>{guide.intent}</p>
        <a href="#quick-info">Quick info</a>
        {guide.sections.map((section) => <a href={`#${section.heading.toLowerCase().replaceAll(' ', '-')}`}>{section.heading}</a>)}
        {hasCommandRows && <a href="#console-commands">Console commands</a>}
        {hasItemCodeRows && <a href="#item-code-table">Item code table</a>}
        {guide.faqs.length > 0 && <a href="#faq">FAQ</a>}
      </aside>

      <div class="guide-content">
        {guideVisual && (
          <figure class="wide-visual guide-visual">
            <img src={guideVisual.src} alt={guideVisual.alt} loading="lazy" decoding="async" />
            <figcaption>{guideVisual.caption}</figcaption>
          </figure>
        )}

        <section id="quick-info" class="info-panel">
          <h2>Quick info</h2>
          <dl class="quick-facts">
            {guide.quickFacts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        </section>

        {guide.sections.map((section) => (
          <section id={section.heading.toLowerCase().replaceAll(' ', '-')} class="guide-section">
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
            {section.bullets && (
              <ul>
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
          </section>
        ))}

        {hasCommandRows && (
          <section id="console-commands" class="guide-section">
            <h2>Console commands</h2>
            <div class="code-table-wrap">
              <table class="code-table">
                <thead>
                  <tr>
                    <th>Command</th>
                    <th>Effect</th>
                  </tr>
                </thead>
                <tbody>
                  {guide.commandRows?.map((row) => (
                    <tr>
                      <td><code>{row.command}</code></td>
                      <td>{row.effect}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {hasItemCodeRows && (
          <section id="item-code-table" class="guide-section">
            <h2>Item code table</h2>
            <div class="code-table-wrap">
              <table class="code-table">
                <thead>
                  <tr>
                    <th>Item</th>
                    <th>Code</th>
                    <th>Note</th>
                  </tr>
                </thead>
                <tbody>
                  {guide.itemCodeRows?.map((row) => (
                    <tr>
                      <td>{row.item}</td>
                      <td><code>{row.code}</code></td>
                      <td>{row.note ?? 'Use with item [code] [amount].'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {guide.sources && guide.sources.length > 0 && (
          <section class="guide-section">
            <h2>References</h2>
            <ul>
              {guide.sources.map((source) => (
                <li><a class="text-link" href={source.url} rel="nofollow noopener" target="_blank">{source.label}</a></li>
              ))}
            </ul>
          </section>
        )}

        {guide.faqs.length > 0 && (
          <section id="faq" class="guide-section">
            <h2>{guide.shortTitle} FAQ</h2>
            <div class="faq-list">
              {guide.faqs.map((faq) => (
                <details>
                  <summary>{faq.question}</summary>
                  <p>{faq.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        {relatedGuides.length > 0 && (
          <section class="related-guides">
            <div class="section-heading section-heading--row">
              <div>
                <p class="eyebrow">Related guides</p>
                <h2>Keep going</h2>
              </div>
              <a class="text-link" href="/">Guide hub</a>
            </div>
            <div class="guide-grid">
              {relatedGuides.map((related) => <GuideCard guide={related} compact />)}
            </div>
          </section>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
