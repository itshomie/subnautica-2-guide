---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/guides';

const title = 'Privacy Policy';
const description = 'Privacy Policy for Subnautica 2 Guide, including contact data, server logs, Google Analytics, cookies, and future Google AdSense disclosures.';
---

<BaseLayout title={title} description={description} canonical={`${site.url}/privacy-policy/`}>
  <section class="content-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Privacy Policy', href: '/privacy-policy/' }]} />
    <p class="eyebrow">Last updated: May 18, 2026</p>
    <h1>Privacy Policy</h1>
    <p>
      This Privacy Policy explains how Subnautica 2 Guide handles information
      when you visit subnautica-2-guide.com or contact us.
    </p>

    <h2>Information We Collect</h2>
    <ul>
      <li>Basic server log data, such as IP address, browser type, referring page, pages viewed, and request time.</li>
      <li>Information you send by email, such as your email address and message content.</li>
      <li>Cookie or similar identifier data from analytics, advertising, or embedded third-party services when those services are enabled.</li>
    </ul>

    <h2>How We Use Information</h2>
    <ul>
      <li>To operate, secure, and improve the site.</li>
      <li>To respond to emails and correction requests.</li>
      <li>To understand site performance and content quality.</li>
      <li>To display and measure ads if advertising is enabled.</li>
    </ul>

    <h2>Google Analytics</h2>
    <p>
      This site uses Google Analytics to understand page views, traffic sources,
      device and browser information, and general content performance. Google
      Analytics may use cookies or similar technologies to measure site usage.
      We use this information to improve guide coverage and site usability.
    </p>

    <h2>Advertising and Google AdSense</h2>
    <p>
      If Google AdSense or other advertising services are enabled, third-party
      vendors, including Google, may use cookies or similar technologies to
      serve ads based on your prior visits to this site or other websites.
      Google's use of advertising cookies enables it and its partners to serve
      ads based on visits to this site and/or other sites on the Internet.
    </p>
    <p>
      You can opt out of personalized advertising through
      <a class="text-link" href="https://www.google.com/settings/ads" rel="nofollow noopener" target="_blank">Google Ads Settings</a>.
      You can also visit
      <a class="text-link" href="https://www.aboutads.info/choices/" rel="nofollow noopener" target="_blank">AboutAds.info</a>
      for broader choices about participating third-party vendors.
    </p>

    <h2>Cookies</h2>
    <p>
      Cookies may be used for basic site operation, Google Analytics,
      advertising if ads are enabled later, fraud prevention, frequency capping,
      and ad measurement. See our
      <a class="text-link" href="/cookie-policy/">Cookie Policy</a> for more detail.
    </p>

    <h2>EEA, UK, and Switzerland Visitors</h2>
    <p>
      If ads are served to visitors in the European Economic Area, the United
      Kingdom, or Switzerland, the site will use a Google-certified Consent
      Management Platform where required before serving personalized ads.
    </p>

    <h2>Children's Privacy</h2>
    <p>
      This site is a general guide site and is not directed to children under
      13. We do not knowingly collect personal information from children.
    </p>

    <h2>Contact</h2>
    <p>
      For privacy questions, email
      <a class="text-link" href="mailto:support@subnautica-2-guide.com">support@subnautica-2-guide.com</a>.
    </p>
  </section>
</BaseLayout>
