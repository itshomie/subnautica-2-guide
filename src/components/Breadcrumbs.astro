---
type Crumb = {
  label: string;
  href: string;
};

type Props = {
  items: Crumb[];
};

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  {items.map((item, index) => (
    <>
      {index > 0 && <span aria-hidden="true">/</span>}
      <a href={item.href}>{item.label}</a>
    </>
  ))}
</nav>
